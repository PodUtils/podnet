+// T-097 items 3 and 10: a session that the edge ends comes back (`Live`),
+// and a dial waits for it.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn warp_network_session_comes_back_after_the_edge_ends_it() {
