+        assert!(contains(&dns, &53u16.to_be_bytes()));
+        assert!(!contains(&tcp, &53u16.to_be_bytes()));
+        assert!(contains(&tcp, &[127]));
+        assert!(!contains(&dns, &[127]));
+        assert!(contains(&tcp, &4242u16.to_be_bytes()));
+    }
+
