@@ -0,0 +1,130 @@
+//! GitHub #737: the line of a name that does not resolve gives each cause
+//! of the resolvers in full, one time, in each command. The resolver is
+//! pod-dns with eight stand-in resolvers that fail in two ways, as in the
+//! lab `no-proxy-no-dns` (no IPv6, no route).
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use pod_core::{BoxFuture, Class, Connected, Dial, Failure, Resolve as _, Stage, Target};
+use pod_dns::{Doh, Resolver, Settings};
+use pod_tls::{Context, Words};
+use tokio::time::Instant;
+
+/// A way out that fails each dial: no IPv6, and no route for IPv4.
+struct NoNetwork;
+
+impl Dial for NoNetwork {
+    fn label(&self) -> String {
+        "no network".into()
+    }
+
+    fn dial<'a>(
+        &'a self,
+        target: &'a Target,
+        _deadline: Instant,
+    ) -> BoxFuture<'a, Result<Connected, Failure>> {
+        Box::pin(async move {
+            let why = match target {
+                Target::Addr(a) if a.is_ipv6() => {
+                    "Address family not supported by protocol (os error 97)"
+                }
+                _ => "Network is unreachable (os error 101)",
+            };
+            let text = format!("could not connect to {target}: {why}");
+            Err(Failure::new(Stage::Connect, Class::Unavailable, text))
+        })
+    }
+}
+
+/// The resolver of pod-dns over eight stand-ins: four of IPv6, four of
+/// IPv4.
+fn resolver() -> Resolver {
+    let mut resolvers = Vec::new();
+    for i in 1..=4u16 {
+        let v6 = std::net::Ipv6Addr::new(0x2001, 0xdb8, 0, 0, 0, 0, 0, i);
+        resolvers.push(Doh::new(v6.into(), "doh.test").json("/q"));
+    }
+    for i in 1..=4u8 {
+        resolvers.push(Doh::new([192, 0, 2, i].into(), "doh.test").json("/q"));
+    }
+    let settings = Settings {
+        resolvers,
+        system: Some(Duration::from_secs(5)),
+        memory: false,
+        ..Settings::default()
+    };
+    let context = Arc::new(Context::new(
+        Arc::new(rustls::crypto::ring::default_provider()),
+        pod_tls::Settings::new(Words::new("podnet")),
+    ));
+    Resolver::new(settings).with_doh(context, Arc::new(NoNetwork))
+}
+
+#[tokio::test]
+async fn the_failure_of_a_name_gives_each_cause_in_full_in_each_command() {
+    let _keep = tracing::subscriber::set_default(crate::exit::resolvers::subscriber());
+    let host = "nothing.invalid";
+    let deadline = Instant::now() + Duration::from_secs(20);
+    let failure = resolver()
+        .resolve(host, 80, deadline)
+        .await
+        .expect_err("a name of .invalid does not resolve");
+    let detail = failure.text().to_string();
+    let dial = || {
+        let resolve = pod_proxy::DialError::Resolve {
+            host: host.into(),
+            detail: detail.clone(),
+        };
+        anyhow::Error::new(Failure::from(resolve))
+    };
+    // The words of each command around the failure of the dial.
+    let cases: [(&str, anyhow::Error); 5] = [
+        (
+            "bench",
+            anyhow::anyhow!(
+                "bench: no request worked: GET http://{host}/: {}",
+                crate::exit::text(&dial().context(format!("connecting to {host}:80")))
+            ),
+        ),
+        (
+            "connect",
+            dial()
+                .context(format!("TCP to {host}"))
+                .context(format!("the remote wss://{host}/ws")),
+        ),
+        (
+            "tunnel",
+            dial()
+                .context(format!("POST https://{host}/tunnel"))
+                .context("provisioning quick tunnel"),
+        ),
+        (
+            "relay connect",
+            dial().context(format!("the relay https://{host}")),
+        ),
+        ("forward", dial()),
+    ];
+    for (command, err) in cases {
+        let line = crate::report::error_line(&err);
+        let first = line.lines().next().unwrap_or_default();
+        assert!(!first.contains("..."), "{command}: {line}");
+        for cause in [
+            "Address family not supported by protocol",
+            "Network is unreachable",
+            "system resolver: ",
+        ] {
+            assert_eq!(
+                first.matches(cause).count(),
+                1,
+                "{command}: {cause}: {line}"
+            );
+        }
+        assert!(!first.contains("(os error"), "{command}: {line}");
+        assert!(
+            first.len() < 500,
+            "{command}: {} bytes: {first}",
+            first.len()
+        );
+    }
+}
