+//! The failures of the resolvers in full (GitHub #737).
+//!
+//! pod-dns folds the failures of a name that does not resolve into one
+//! phrase: the cause that the most resolvers had (`lookup::fold`), in at
+//! most 160 bytes, cut with "..." (`order::fit`). The other causes, and
+//! the cut words, go only to its log at debug. [`layer`] keeps these two
+//! events of the log, and [`full`] puts them back into a line: each cause
+//! once, and no cause cut.
+
+use std::cell::RefCell;
+use std::sync::Mutex;
+
+use tracing::field::{Field, Visit};
+use tracing::{Event, Level, Subscriber};
+use tracing_subscriber::filter::{Filtered, Targets};
+use tracing_subscriber::layer::{Context, Layer, SubscriberExt as _};
+
+/// The event of pod-dns with the failure of each resolver of DNS over
+/// HTTPS (`lookup.rs`).
+const LOOKUP: (&str, &str) = ("pod_dns::lookup", "each resolver of DNS over HTTPS failed");
+/// The event of pod-dns with the failure of each source, not cut
+/// (`order.rs`).
+const ORDER: (&str, &str) = ("pod_dns::order", "each source of the addresses failed");
+/// The words of pod-proxy before the failure of a name.
+const LEAD: &str = "could not resolve ";
+/// The words of pod-dns before the failures of DNS over HTTPS.
+const DOH: &str = "DNS over HTTPS: ";
+/// The most bytes of the phrase of pod-dns (`order::LINE`).
+const CUT: usize = 160;
+/// The failures that [`full`] knows: the last ones.
+const KEPT: usize = 16;
+
+/// The failures of one name, as the log of pod-dns gave them.
+#[derive(Clone, Debug)]
+struct Said {
+    /// The name, when the event of DNS over HTTPS came first.
+    host: Option<String>,
+    /// The failure of each source, joined with `; `, not cut.
+    whole: String,
+    /// The failures of DNS over HTTPS in groups of one cause.
+    each: Option<String>,
+}
+
+static SAID: Mutex<Vec<Said>> = Mutex::new(Vec::new());
+
+thread_local! {
+    /// The name and the failures of the last lookup of DNS over HTTPS on
+    /// this thread: pod-dns logs the failure of the sources in the same poll.
+    static LOOKUP_SEEN: RefCell<Option<(String, String)>> = const { RefCell::new(None) };
+}
+
+/// The layer that keeps the failures of the resolvers, with its filter:
+/// the two events of pod-dns at debug, and nothing else.
+pub fn layer<S>() -> Filtered<Keep, Targets, S>
+where
+    S: Subscriber + for<'a> tracing_subscriber::registry::LookupSpan<'a>,
+{
+    let targets = Targets::new()
+        .with_target(LOOKUP.0, Level::DEBUG)
+        .with_target(ORDER.0, Level::DEBUG);
+    Keep.with_filter(targets)
+}
+
+/// A subscriber with [`layer`] alone, for a test.
+pub fn subscriber() -> impl Subscriber + Send + Sync {
+    tracing_subscriber::registry().with(layer())
+}
+
+/// The layer of [`layer`].
+pub struct Keep;
+
+impl<S: Subscriber> Layer<S> for Keep {
+    fn on_event(&self, event: &Event<'_>, _: Context<'_, S>) {
+        let target = event.metadata().target();
+        if target != LOOKUP.0 && target != ORDER.0 {
+            return;
+        }
+        let mut fields = Fields::default();
+        event.record(&mut fields);
+        if (target, fields.message.as_str()) == LOOKUP {
+            LOOKUP_SEEN.with(|seen| *seen.borrow_mut() = Some((fields.host, fields.failures)));
+        } else if (target, fields.message.as_str()) == ORDER {
+            let (host, each) = LOOKUP_SEEN
+                .with(|seen| seen.borrow_mut().take())
+                .map_or((None, None), |(h, e)| (Some(h), Some(e)));
+            let mut said = SAID.lock().unwrap_or_else(|e| e.into_inner());
+            if said.len() >= KEPT {
+                said.remove(0);
+            }
+            said.push(Said {
+                host,
+                whole: fields.failures,
+                each,
+            });
+        }
+    }
+}
+
+/// The fields of an event of pod-dns.
+#[derive(Default)]
+struct Fields {
+    message: String,
+    host: String,
+    failures: String,
+}
+
+impl Visit for Fields {
+    fn record_str(&mut self, field: &Field, value: &str) {
+        self.record_debug(field, &value);
+    }
+
+    fn record_debug(&mut self, field: &Field, value: &dyn std::fmt::Debug) {
+        let text = format!("{value:?}");
+        match field.name() {
+            "message" => self.message = text,
+            "host" => self.host = text,
+            "failures" => self.failures = text,
+            _ => {}
+        }
+    }
+}
+
+/// `text` with each failure of a name that [`layer`] kept in full: the
+/// phrase of pod-dns after `could not resolve HOST: ` (cut or folded) is
+/// the failure of each source, and DNS over HTTPS gives each cause once.
+pub fn full(text: &str) -> String {
+    if !text.contains(LEAD) {
+        return text.to_string();
+    }
+    let said = SAID.lock().unwrap_or_else(|e| e.into_inner()).clone();
+    let mut out = String::with_capacity(text.len());
+    let mut rest = text;
+    while let Some(at) = rest.find(LEAD) {
+        let after = &rest[at + LEAD.len()..];
+        let Some(colon) = after.find(": ") else {
+            break;
+        };
+        let host = &after[..colon];
+        let detail = &after[colon + 2..];
+        out.push_str(&rest[..at + LEAD.len() + colon + 2]);
+        let found = said.iter().rev().find_map(|s| {
+            let named = s.host.as_deref().is_none_or(|h| h == host);
+            named.then(|| fits(s, detail)).flatten()
+        });
+        rest = match found {
+            Some((len, whole)) => {
+                out.push_str(&whole);
+                &detail[len..]
+            }
+            None => detail,
+        };
+    }
+    out.push_str(rest);
+    out
+}
+
+/// The length of the phrase of `said` at the start of `detail`, and the
+/// phrase in full; none when `detail` does not start with it.
+fn fits(said: &Said, detail: &str) -> Option<(usize, String)> {
+    let whole = &said.whole;
+    let len = if detail.starts_with(whole.as_str()) {
+        whole.len()
+    } else {
+        let mut window = detail.len().min(CUT);
+        while !detail.is_char_boundary(window) {
+            window -= 1;
+        }
+        let end = detail[..window].rfind("...")? + 3;
+        if !cut_of(&detail[..end], whole) {
+            return None;
+        }
+        end
+    };
+    Some((len, expand(whole, said.each.as_deref())))
+}
+
+/// `cut` is `whole` with some phrases cut short ("..." at the end of each).
+fn cut_of(cut: &str, whole: &str) -> bool {
+    let start = |a: &str, b: &str| b.starts_with(a.trim_end_matches("..."));
+    let split = |t: &'static str, s: &str| -> (String, String) {
+        match s.split_once(t) {
+            Some((a, b)) => (a.to_string(), b.to_string()),
+            None => (s.to_string(), String::new()),
+        }
+    };
+    let sep = "; DNS over HTTPS: ";
+    let ((c1, c2), (w1, w2)) = (split(sep, cut), split(sep, whole));
+    start(cut, whole) || (!c2.is_empty() && start(&c1, &w1) && start(&c2, &w2))
+}
+
+/// `whole` with the folded phrase of DNS over HTTPS ("8 resolvers failed,
+/// 4 with: CAUSE") as each group of causes: "8 resolvers failed: 4 with:
+/// CAUSE; 4 with: OTHER".
+fn expand(whole: &str, each: Option<&str>) -> String {
+    let Some(each) = each else {
+        return whole.to_string();
+    };
+    let Some(at) = whole.find(DOH) else {
+        return whole.to_string();
+    };
+    let doh = &whole[at + DOH.len()..];
+    let Some((count, _)) = doh.split_once(" resolvers failed, ") else {
+        return whole.to_string();
+    };
+    if count.is_empty() || !count.bytes().all(|b| b.is_ascii_digit()) {
+        return whole.to_string();
+    }
+    format!(
+        "{}{DOH}{count} resolvers failed: {}",
+        &whole[..at],
+        groups(each)
+    )
+}
+
+/// The groups of `each` of pod-dns (`N resolvers (A, B): CAUSE; X: OTHER`)
+/// as `N with: CAUSE; X: OTHER`, with no number of the system.
+fn groups(each: &str) -> String {
+    let mut out = String::new();
+    for (i, part) in each.split("; ").enumerate() {
+        if i > 0 {
+            out.push_str("; ");
+        }
+        let head = part.split_once(" resolvers (").and_then(|(n, rest)| {
+            let n_ok = !n.is_empty() && n.bytes().all(|b| b.is_ascii_digit());
+            let (_, cause) = rest.split_once("): ")?;
+            n_ok.then(|| format!("{n} with: {cause}"))
+        });
+        out.push_str(&head.unwrap_or_else(|| part.to_string()));
+    }
+    without_os_error(&out)
+}
+
+/// `text` with no ` (os error N)`.
+fn without_os_error(text: &str) -> String {
+    let mut out = text.to_string();
+    while let Some(at) = out.find(" (os error ") {
+        let Some(end) = out[at..].find(')') else {
+            break;
+        };
+        out.replace_range(at..at + end + 1, "");
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The family of the phrases of pod-dns: cut, folded, both, and one
+    /// that holds no cut and no fold.
+    #[test]
+    fn each_phrase_of_the_resolvers_is_said_in_full() {
+        let system = "system resolver: failed to lookup address information: Try again";
+        let each = "4 resolvers (2001:db8::1, 2001:db8::2, 2001:db8::3, 2001:db8::4): could not connect: Address family not supported by protocol (os error 97); 4 resolvers (192.0.2.1, 192.0.2.2, 192.0.2.3, 192.0.2.4): could not connect: Network is unreachable (os error 101)";
+        let folded = format!("{system}; DNS over HTTPS: 8 resolvers failed, 4 with: could not connect: Address family not supported by protocol");
+        let want = format!("{system}; DNS over HTTPS: 8 resolvers failed: 4 with: could not connect: Address family not supported by protocol; 4 with: could not connect: Network is unreachable");
+        let said = Said {
+            host: Some("x.invalid".into()),
+            whole: folded.clone(),
+            each: Some(each.into()),
+        };
+        let cut = format!("{}...", &folded[..140]);
+        let cut_each =
+            format!("{system}; DNS over HTTPS: 8 resolvers failed, 4 with: could not con...");
+        let cases = [
+            (folded.clone(), Some(want.clone())),
+            (cut, Some(want.clone())),
+            (cut_each, Some(want.clone())),
+            ("system resolver: no address".to_string(), None),
+        ];
+        for (detail, want) in cases {
+            let got = fits(&said, &detail).map(|(len, whole)| {
+                assert_eq!(len, detail.len(), "{detail}");
+                whole
+            });
+            assert_eq!(got, want, "{detail}");
+        }
+    }
+}
