@@ -16,8 +16,8 @@
       "type": "string"
     },
     "backend": {
-      "description": "The backend that runs the program, or null when no backend was chosen or none could start.",
-      "enum": ["netns", "seccomp", null]
+      "description": "The backend that runs the program (the words of --backend), or null when no backend was chosen or none could start.",
+      "enum": ["netns", "netns-kernel", "seccomp", null]
     },
     "choice": {
       "description": "The reason of the choice of the backend, or null when none was chosen.",
@@ -33,7 +33,7 @@
       "items": { "type": "string" }
