     "udp_limit": {
-      "description": "The most bytes of a UDP datagram that the backend carries, or null when it has no limit (or no backend).",
+      "description": "The most bytes of a UDP datagram that the backend carries (65507 for netns), or null when it has no limit (seccomp, netns-kernel) or no backend.",
       "type": ["integer", "null"],
       "minimum": 1
     },
